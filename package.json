{
  "name": "@damiensmith1/cairn",
  "version": "0.1.1",
  "description": "Searchable memory for your Claude Code sessions: local hybrid search with reranking, a CLI, and an MCP server for agents.",
  "license": "MIT",
  "author": "Damien Smith",
  "homepage": "https://github.com/damiensmith1/cairn#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/damiensmith1/cairn.git"
  },
  "bugs": {
    "url": "https://github.com/damiensmith1/cairn/issues"
  },
  "keywords": [
    "claude-code",
    "mcp",
    "mcp-server",
    "semantic-search",
    "hybrid-search",
    "rag",
    "sqlite",
    "sqlite-vec",
    "ollama",
    "embeddings",
    "reranking",
    "local-first",
    "cli"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "cairn": "./dist/cli.js"
  },
  "files": [
    "dist",
    "scripts/prune.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cairn": "tsx src/cli.ts",
    "train-labels": "tsx scripts/train-labels.ts",
    "eval:retrieval": "tsx scripts/eval-retrieval.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@clack/prompts": "^1.8.1",
    "@huggingface/transformers": "^4.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^13.0.3",
    "plainlog": "^1.0.3",
    "smol-toml": "^1.9.1",
    "sqlite-vec": "^0.1.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
